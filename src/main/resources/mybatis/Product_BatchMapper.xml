<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Product_BatchMapper">
    <select id="product_BatchSelect" parameterType="int" resultType="int">
        select batch_id from product_batch where product_id=#{value}
        order by inbound_date asc
    </select>

</mapper>